# NeuroSense AI - Environment Variables Reference
# Secrets (Required in all environments - server refuses to start without these)
NEUROSENSE_PEPPER=replace_with_secure_random_clinical_pepper_at_least_32_chars
JWT_SECRET=replace_with_secure_random_jwt_secret_at_least_32_chars

# Database Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=dementia_db

# Server Configuration
PORT=5000
FLASK_DEBUG=0
APP_ENV=development

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Development Seeds (optional, default 0)
DEV_SEED_DEMO_USER=0
